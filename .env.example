# Google Sheet ID (the long part of the sheet URL between /d/ and /edit)
GOOGLE_SHEET_ID=165HYVQCu1ko2mkqAdDZM5gw9UbNJkeVRjF_vgUSlI9U
# Service account (Google Cloud > IAM > Service Accounts). Share the sheet with this email.
GOOGLE_SERVICE_ACCOUNT_EMAIL=flight-log@your-project.iam.gserviceaccount.com
# Private key from the service account JSON. Keep the \n sequences, wrap in quotes.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# First session of the course (YYYY-MM-DD). Used to compute the current course week.
COURSE_START=2026-11-09
# Saving from the app (new entries, milestones). Needs Editor access for the service account.
ENABLE_WRITES=true
# Passcode asked once per device before saving. Without it, anyone with the link could write to the sheet.
WRITE_PASSCODE=choose-a-passcode
